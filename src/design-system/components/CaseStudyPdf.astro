---
type Props = {
  src: string;
  title: string;
  caption?: string;
};

const { src, title, caption } = Astro.props;
---

<figure class="my-8">
  <div class="soft-image-shadow overflow-hidden rounded-xl border border-ink-300/20">
    <iframe src={src} title={title} class="h-[80vh] w-full" loading="lazy"></iframe>
  </div>
  <figcaption class="mt-2 text-sm text-ink-300">
    {caption && <span>{caption} — </span>}
    <a href={src} target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">
      Open PDF in new tab
    </a>
  </figcaption>
</figure>
