---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { WigglyFrame } from "../design-system/components/WigglyFrame";
import photo from "../content/case-studies/images/ClemPortfolioPhoto.png";

const optimizedPhoto = await getImage({ src: photo });
---

<BaseLayout title="About — Clem" description="A bit about Clem, a UI/UX designer based in Montréal.">
	<div class="mx-auto max-w-3xl blur-fade-in pb-24">
		<div class="flex flex-col items-center gap-10">
			<div class="relative w-56 shrink-0">
				<img
					src={optimizedPhoto.src}
					alt="Portrait of Clem"
					width={optimizedPhoto.attributes.width}
					height={optimizedPhoto.attributes.height}
					class="aspect-square w-full rounded-full object-cover"
				/>
				<WigglyFrame client:load radius={999} strokeWidth={8} />
			</div>

			<div class="prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-paper prose-p:text-ink-100">
				<h1 class="font-serif text-4xl text-paper">Hellooo</h1>

				<p>
					I’m Clément, a UI/UX designer based in Montréal. I started out designing 24 pages of newsprint a week at my university paper, then moved into graphic design in Montréal’s arts and culture scene, including POP Montreal, with freelance projects for Urbania, C2 and MRCY Fest along the way.
				</p>

				<p>
					In 2018 I joined Sportlogiq as a graphic designer on the media team, where I built out countless templates for social media posts and automated graphics generation using live data. I later moved into UX and spent the past several years as the sole UX designer, covering research, wireframes, prototyping and maintaining the component library for both a client-facing app and an internal operations tool.
				</p>

				<p>
					Most recently I redesigned a soccer data-entry workflow and built a working prototype with AI (Lovable). It validated a 20–40% reduction in processing time and helped extend a 7 figure contract. These days I’m using Claude Code with Figma MCPs to build design systems that are ready for AI to ideate and prototype with.
				</p>

				<p>Je suis bilingue !</p>

				<p>
					Contact:<br />
					<a href="mailto:lettersforclem@gmail.com">lettersforclem@gmail.com</a>
				</p>
			</div>
		</div>
	</div>
</BaseLayout>
