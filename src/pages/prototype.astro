---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PrototypeViewer } from "../design-system/components/PrototypeViewer";

// Add prototypes here: paste the regular Figma prototype link as `figmaUrl`
// and it's converted to an embeddable one below. Each one gets its own page
// in the pagination, in this order.
const prototypes: { title: string; figmaUrl: string }[] = [
	{
		title: "Prototype 1",
		figmaUrl:
			"https://www.figma.com/proto/xOFtqBj6hEdv1OU8gECbud/Prototypes?node-id=10-9988&viewport=-790%2C74%2C0.72&t=OaE86knGDjgkIuW5-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=10%3A9988&page-id=0%3A1",
	},
	{
		title: "Prototype 2",
		figmaUrl:
			"https://www.figma.com/proto/xOFtqBj6hEdv1OU8gECbud/Prototypes?node-id=10-33357&viewport=-2277%2C318%2C0.74&t=RShGZwU1xDLMOxBn-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=10%3A9988&page-id=0%3A1",
	},
];

const toEmbedUrl = (figmaUrl: string) => {
	const url = new URL(figmaUrl);
	url.host = "embed.figma.com";
	url.searchParams.set("embed-host", "share");
	return url.toString();
};

const items = prototypes.map((p) => ({ ...p, embedUrl: toEmbedUrl(p.figmaUrl) }));
---

<BaseLayout title="Prototype — Clem" description="A playground of prototypes by Clem.">
	<div class="mx-auto max-w-5xl blur-fade-in pb-24">
		<h1 class="sr-only">Prototype</h1>
		<PrototypeViewer client:load prototypes={items} />
	</div>
</BaseLayout>
