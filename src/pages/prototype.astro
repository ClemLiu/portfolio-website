---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PrototypeViewer, type Prototype } from "../design-system/components/PrototypeViewer";

// Each entry is one page of the pagination, in this order. Either:
//  - `native`: a prototype rebuilt on the page itself, or
//  - `figmaUrl`: paste a regular Figma prototype link; it's converted to an
//    embeddable one below.
const prototypes: ({ title: string; native: "targetsTable" } | { title: string; figmaUrl: string })[] = [
	{
		title: "Table Interactions",
		native: "targetsTable",
	},
	{
		title: "Landing Page Interactions",
		figmaUrl:
			"https://www.figma.com/proto/xOFtqBj6hEdv1OU8gECbud/Prototypes?node-id=10-33357&viewport=-2277%2C318%2C0.74&t=RShGZwU1xDLMOxBn-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=10%3A9988&page-id=0%3A1",
	},
];

const toEmbedUrl = (figmaUrl: string) => {
	const url = new URL(figmaUrl);
	url.host = "embed.figma.com";
	url.searchParams.set("embed-host", "share");
	return url.toString();
};

const items: Prototype[] = prototypes.map((p) =>
	"figmaUrl" in p ? { title: p.title, figmaUrl: p.figmaUrl, embedUrl: toEmbedUrl(p.figmaUrl) } : p,
);
---

<BaseLayout title="Prototype — Clem" description="A playground of prototypes by Clem.">
	<div class="mx-auto max-w-5xl blur-fade-in pb-24">
		<h1 class="sr-only">Prototype</h1>
		<PrototypeViewer client:load prototypes={items} />
	</div>
</BaseLayout>
