---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Tag } from "../../design-system/components/Tag";
import { ExpandableImage } from "../../design-system/components/ExpandableImage";

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, tags, meta, mainImage, mainImageAlt } = entry.data;
const { Content } = await render(entry);
const optimizedMainImage = await getImage({ src: mainImage });
---

<BaseLayout title={`${title} — Clem`} description={description}>
	<div class="mx-auto max-w-3xl blur-fade-in">
		<ExpandableImage
			client:load
			src={optimizedMainImage.src}
			alt={mainImageAlt}
			width={optimizedMainImage.attributes.width}
			height={optimizedMainImage.attributes.height}
			className="w-full rounded-xl"
		/>

		<div class="mt-6 space-y-3 pb-4">
			<div class="flex flex-wrap items-center gap-2">
				{tags.map((tag: string) => <Tag>{tag}</Tag>)}
				{meta && (
					<span class="font-mono text-xs uppercase tracking-wide text-ink-300">{meta}</span>
				)}
			</div>
			<h1 class="font-serif text-4xl text-paper">{title}</h1>
		</div>

		<div class="prose prose-invert max-w-none pb-24 prose-headings:font-serif prose-headings:text-paper prose-p:text-ink-100 prose-img:rounded-xl prose-img:my-0 prose-figure:my-0">
			<Content />
		</div>
	</div>
</BaseLayout>
