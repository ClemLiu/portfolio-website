---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BuyLowTool } from "../../design-system/buylow/BuyLowTool";
import "../../design-system/buylow/buylow.css";

// read at build time for the header; the tool fetches the same file in the browser
const data = JSON.parse(readFileSync(join(process.cwd(), "public/data/players.json"), "utf8"));
const updated = new Date(data.generatedAt).toLocaleDateString("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
	timeZone: "America/Toronto",
});
// a plain calendar date (YYYYMMDD), so it's formatted in UTC to keep the day from shifting
const through =
	data.gamesThrough &&
	new Date(`${data.gamesThrough.replace(/^(\d{4})(\d{2})(\d{2})$/, "$1-$2-$3")}T00:00:00Z`).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});

const intro = `I use it this tool to help determine my Yahoo fantasy hockey league moves. The model compares players actual stats to expected values (MoneyPuck) and 3 year weighted averages. This is currently only for Yahoo points leagues. Set your leagues FP settings and start using the tool.

Bookmark the page or save the URL to keep your FP settings and filters. You can bookmark multiple settings/filters for different leagues!`;

const description = "A fantasy hockey tool for finding buy-low and sell-high players.";
// What LinkedIn and other apps show when the page is shared. There's deliberately no og:url, so a shared link
// keeps the settings in it. The image (1200 x 630, from the data repo's docs/images) is a fixed illustration;
// give a new one a new file name, as apps cache it.
const share = {
	title: "Hot & Cold, find hidden value on your fantasy hockey team!",
	image: "https://www.heyclem.ca/og/social-preview.png",
	imageAlt: "Who’s hot? Who’s cold? Fantasy hockey skaters scoring above or below their expected values",
};
---

<BaseLayout title="Hot & Cold ! — Clem" description={description}>
	<Fragment slot="head">
		<meta property="og:type" content="website" />
		<meta property="og:title" content={share.title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={share.image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={share.imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<link
			href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=Geist+Mono:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>
	<div class="blur-fade-in pb-24">
		<!-- overflow-clip rounds the corners without becoming a scroll container, so the table header can stick.
		     On phones the box runs edge to edge (-mx-10 cancels the layout's side padding) to give the table room. -->
		<div class="soft-image-shadow -mx-10 overflow-clip border-y border-ink-300/20 bg-[#12100f] py-3 md:mx-0 md:rounded-xl md:border-x md:p-6">
			<header class="bl-tokens bl-intro">
				<h1>Hot &amp; Cold !</h1>
				<p>{intro}</p>
				<p class="bl-source">
					Data from <a href="https://moneypuck.com" target="_blank" rel="noopener noreferrer">MoneyPuck.com</a>{" "}
					and <a href="https://www.nhl.com" target="_blank" rel="noopener noreferrer">NHL.com</a> (player bios)
					· {data.seasonLabel} season · Updated {updated}
					{through && ` · Games through ${through}`}
				</p>
			</header>
			<BuyLowTool client:only="react">
				<div slot="fallback" class="bl-tokens min-h-[520px] px-4 md:px-0">Loading players…</div>
			</BuyLowTool>
		</div>
	</div>
</BaseLayout>
